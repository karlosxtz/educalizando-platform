# =============================================================================
# EDUCALIZANDO — ENVIROMENT VARIABLES FOR VERCEL
# =============================================================================

# SUPABASE CONFIGURATION
NEXT_PUBLIC_SUPABASE_URL=https://ljmfonterxaiqvbdfkye.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_public_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_server_only_key_here

# MINIO / OBJECT STORAGE — todos os arquivos binários ficam aqui; o Supabase
# guarda somente os registros, permissões e referências no banco de dados.
OBJECT_STORAGE_ENDPOINT=https://arquivos.seu-dominio.com
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_ACCESS_KEY_ID=your_minio_access_key
OBJECT_STORAGE_SECRET_ACCESS_KEY=your_minio_secret_key
OBJECT_STORAGE_BUCKET_PUBLIC_IMAGES=public-images
OBJECT_STORAGE_BUCKET_PRIVATE_MATERIALS=private-materials
OBJECT_STORAGE_BUCKET_PRIVATE_PLR=private-plr

# Desenvolvimento local apenas. Não defina na Vercel/produção: pedidos,
# clientes, vendas e acessos devem vir exclusivamente do Supabase.
NEXT_PUBLIC_ENABLE_LOCAL_DEVELOPMENT_DATA=false

# INFINITEPAY CHECKOUT CONFIGURATION
INFINITEPAY_HANDLE=carlos-eduardo-a4j

# ASAAS — mantido temporariamente apenas para o fluxo legado de saques
ASAAS_API_URL=https://www.asaas.com/api/v3
ASAAS_API_KEY=your_server_only_key_here

NEXT_PUBLIC_APP_URL=https://seu-dominio-na-vercel.app
CRON_SECRET=defina-uma-chave-aleatoria-com-no-minimo-16-caracteres
  
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# Endereço/dominio já verificado no painel da Resend. Nunca use NEXT_PUBLIC_ para estes valores.
RESEND_FROM_EMAIL=Educalizando <contato@seudominio.com.br>

# EVOLUTION API — mantenha a chave somente no servidor/Vercel, nunca em NEXT_PUBLIC_
EVOLUTION_API_BASE_URL=https://sua-evolution-api.exemplo.com
EVOLUTION_INSTANCE_NAME=educalizando
EVOLUTION_API_KEY=sua_chave_server_only
