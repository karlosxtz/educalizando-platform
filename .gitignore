# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/

# next.js
/.next/
/.next-vps/
/out/

# production
/build
/tmp/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/dist/
.vinext/
.cloudflare/
.dev.vars
.dev.vars.*
deploy/vps/.env.runtime

# Local n8n exports contain live integration credentials; never publish backups.
/ATENDENTE*.json
/RECUPERADOR*.json
/LIMPAR*.json
# Search Console screenshots may include the signed-in account avatar.
/ops/search-console-*.png
