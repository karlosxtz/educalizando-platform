# Configure these privately in the Integrator panel. Do not commit .env.runtime.
IMAGE_PROCESSOR_SECRET=replace_with_a_random_secret_of_at_least_32_characters
MINIO_ENDPOINT=https://arquivos.educalizando.com.br
MINIO_REGION=us-east-1
# Use a MinIO service account restricted to public-images/uploads/optimized/*.
MINIO_ACCESS_KEY=configure_privately
MINIO_SECRET_KEY=configure_privately
