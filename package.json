    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^13.0.0",
    "heic2any": "^0.0.4",
    "jszip": "^3.10.2",
    "lucide-react": "^1.30.0",
    "next": "16.3.8",
    "next-sitemap": "^4.2.3",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "^7.85.0",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "^3.10.1",
    "resend": "^6.22.1",
    "sharp": "^0.35.5",
    "sonner": "^2.0.8",
