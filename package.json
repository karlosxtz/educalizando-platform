    "test:infinitepay-webhook": "ts-node -P tsconfig.test.json scripts/verify-infinitepay-webhook.ts",
    "test:delivery-access": "ts-node -P tsconfig.test.json scripts/verify-delivery-access.ts",
    "test:search-matching": "ts-node -P tsconfig.test.json scripts/verify-search-matching.ts",
    "test:social-links": "ts-node -P tsconfig.test.json scripts/verify-social-links.ts",
    "test:product-tags": "ts-node -P tsconfig.test.json scripts/verify-product-tags.ts",
    "test:erer-calendar": "ts-node -P tsconfig.test.json scripts/verify-erer-calendar.ts",
